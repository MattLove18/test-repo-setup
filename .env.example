# Captivation Hub / GoHighLevel (LeadConnector API)
# Create a Private Integration Token in your sub-account:
# Settings → Private Integrations → Create, with opportunities + contacts scopes.
GHL_API_KEY=
GHL_LOCATION_ID=

# Optional. If omitted, the app picks a pipeline named like "life", "insurance",
# "client", or "design", otherwise the first pipeline in the location.
GHL_PIPELINE_ID=

# Optional shared secret. Send as ?secret= or Authorization: Bearer <secret>
# on POST /api/webhooks/ghl
GHL_WEBHOOK_SECRET=
